 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\n<style>\n    .pf-color {\n        color: {{ color }};\n    }\n</style>\n\n\n<div class=\"pf-font\">\n    \n    {% if letter_head %}\n        {{ letter_head }}\n    {% endif %}\n    \n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\n        <tbody>\n            {% if doc.mode_of_payment %}\n                <tr>\n                    <td class=\"pf-color\" style=\"width: 50%;\">\n                        <p>Mode of Payment \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639 </p>\n                    </td>\n                    <td style=\"width: 50%;\">\n                        <p>{{ doc.mode_of_payment }}</p>\n                    </td>\n                </tr>\n            {% endif %}\n            {% if doc.party_type %}\n                <tr>\n                    <td class=\"pf-color\" style=\"width: 50%;\">\n                        <p>Party Type \u0646\u0648\u0639 \u0627\u0644\u062d\u0633\u0627\u0628</p>\n                    </td>\n                    <td style=\"width: 50%;\">\n                        <p>{{ doc.party_type }}</p>\n                    </td>\n                </tr>\n            {% endif %}\n            {% if doc.party_name %}\n                <tr>\n                    <td class=\"pf-color\" style=\"width: 50%;\">\n                        <p>Party Name \u0627\u0633\u0645 \u0627\u0644\u062d\u0633\u0627\u0628</p>\n                    </td>\n                    <td style=\"width: 50%;\">\n                        <p>{{ doc.party_name }}</p>\n                    </td>\n                </tr>\n            {% endif %}\n            <tr>\n                <td class=\"pf-color\" style=\"width: 50%;\">\n                    <p>Posting Date \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u062c\u064a\u0644</p>\n                </td>\n                <td style=\"width: 50%;\">\n                    <p>{{ doc.get_formatted(\"posting_date\") }}</p>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <table class=\"pf-item-table pf-font-size\" style=\"border-bottom: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }};\">\n                <th style=\"text-align: center; width: 25%;\">Cheque No.<br>\u0627\u0644\u0634\u064a\u0643</th>\n                <th style=\"text-align: center; width: 25%;\">Date<br>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th>\n                <th style=\"text-align: center; width: 25%;\">Account<br>\u0627\u0644\u062d\u0633\u0627\u0628</th>\n                <th style=\"text-align: center; width: 25%;\">Amount<br>\u0627\u0644\u0645\u0628\u0644\u063a</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td style=\"text-align: center;\">{{ doc.reference_no }}</td>\n                <td style=\"text-align: center;\">{{ doc.get_formatted(\"reference_date\") }}</td>\n                <td style=\"text-align: center;\">{{ doc.paid_from }}</td>\n                <td style=\"text-align: center;\">{{ doc.get_formatted(\"paid_amount\") }}</td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <p style=\"width: 100%; text-align: right;\">In Words: {{ doc.in_words }}</p>\n    \n    <table class=\"pf-item-table pf-font-size\" style=\"border-bottom: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }};\">\n                <th style=\"text-align: center; width: 20%;\">Reference Type<br>\u0646\u0648\u0639 \u0627\u0644\u0645\u0631\u062c\u0639</th>\n                <th style=\"text-align: center; width: 20%;\">Name<br>\u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u062c\u0639</th>\n                <th style=\"text-align: center; width: 20%;\">Total Amount<br>\u0627\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th>\n                <th style=\"text-align: center; width: 20%;\">Allocated Amount<br>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062e\u0635\u0635</th>\n                <th style=\"text-align: center; width: 20%;\">Outstanding Amount<br>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062a\u0628\u0642\u064a</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.references %}\n                <tr>\n                    <td style=\"text-align: center;\">{{ row.reference_doctype }}</td>\n                    <td style=\"text-align: center;\">{{ row.reference_name }}</td>\n                    <td style=\"text-align: center;\">{{ row.get_formatted(\"total_amount\", doc) }}</td>\n                    <td style=\"text-align: center;\">{{ row.get_formatted(\"allocated_amount\", doc) }}</td>\n                    <td style=\"text-align: center;\">{{ row.get_formatted(\"outstanding_amount\", doc) }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n        <tr>\n            <td rowspan=\"3\" style=\"width: 25%;\">\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ doc.name }}&size=120x120\">\n            </td>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                {% if doc.party_name %}\n                    Received By \u0627\u0644\u0645\u0633\u062a\u0644\u0645:\n                {% endif %}\n            </td>\n            <td style=\"width: 30%;\">\n                {% if doc.party_name %}\n                    {{ doc.party_name }}\n                {% endif %}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                {% if doc.contact_person %}\n                    Mobile No \u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644:\n                {% endif %}\n            </td>\n            <td style=\"width: 30%;\">\n                {% if doc.contact_person %}\n                    {{ frappe.db.get_value(\"Contact\", doc.contact_person, \"mobile_no\") }}\n                {% endif %}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                Date \u0627\u0644\u062a\u0627\u0631\u064a\u062e:\n            </td>\n            <td style=\"width: 30%;\">\n                {{ doc.get_formatted(\"posting_date\") }}\n            </td>\n        </tr>\n    </table>\n    \n    {% if doc.terms %}\n        <div class=\"pf-terms pf-font-size\">\n            <p><strong class=\"pf-color\">Terms and conditions</strong></p>\n            <br>\n            <p>{{ doc.terms }}</p>\n        </div>\n    {% endif %}\n    \n    {% if footer %}\n        <div id=\"footer-html\" class=\"visible-pdf\">\n            {{ footer }}\n        </div>\n    {% endif %}\n    \n</div>",
