 "html": "{% set print_style = frappe.db.get_single_value(\"Print Settings\", \"print_style\") %}\n{% set color = frappe.db.get_value(\"Print Style\", print_style, \"custom_color\") %}\n<style>\n    .pf-color {\n        color: {{ color }};\n    }\n</style>\n\n\n<div class=\"pf-font\">\n    \n    {% if letter_head %}\n        {{ letter_head }}\n    {% endif %}\n    \n    <h1 class=\"pf-heading pf-color\">{{ doc.doctype }}</h1>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%; line-height: 1;\">\n        <tbody>\n            <tr>\n                <td class=\"pf-color\" style=\"width: 40%;\">\n                    <p>CUSTOMER DETAILS:</p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{ doc.company }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>Delivery Note # \u0627\u0644\u0631\u0642\u0645 </p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.name }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    <p>{{ doc.customer_name }}</p>\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    <p>Delivery Date \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645 </p>\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    <p>{{ doc.get_formatted(\"posting_date\") }}</p>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"width: 40%; padding-left: 20px!important;\">\n                    {% if doc.contact_mobile %}\n                        <p>{{ doc.contact_mobile }}</p>\n                    {% endif %}\n                </td>\n                <td class=\"pf-color\" style=\"width: 30%; text-align: right;\">\n                    {% if doc.items[0].so_detail %}\n                        <p>Sales Order # \u0631\u0642\u0645 \u0627\u0645\u0631 \u0627\u0644\u0628\u064a\u0639 </p>\n                    {% endif %}\n                </td>\n                <td style=\"width: 30%; text-align: right;\">\n                    {% if doc.items[0].so_detail %}\n                        <p>{{ doc.items[0].so_detail }}</p>\n                    {% endif %}\n                </td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <table class=\"pf-item-table pf-font-size\" style=\"border-bottom: 3px solid {{ color }};\">\n        <thead>\n            <tr style=\"background-color: {{ color }};\">\n                <th style=\"text-align: left; width: 5%;\">No.<br>\u0645</th>\n                <th style=\"text-align: left; width: 75%;\">Name / Description<br>\u0627\u0644\u0627\u0633\u0645 / \u0627\u0644\u0648\u0635\u0641</th>\n                <th style=\"text-align: center; width: 20%;\">QTY / UOM<br>\u0627\u0644\u0643\u0645\u064a\u0629 / \u0627\u0644\u0648\u062d\u062f\u0629</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n                <tr>\n                    <td>{{ item.idx }}</td>\n                    <td>\n                        <strong>{{ item.item_name }}</strong>{% if item.description %}: {{ item.description }}{% endif %}\n                    </td>\n                    <td style=\"text-align: center;\">{{ item.qty }} {{ item.uom }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    \n    <table class=\"pf-font-size\" style=\"width: 100%;\">\n        <tr>\n            <td rowspan=\"3\" style=\"width: 25%;\">\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ doc.name }}&size=120x120\">\n            </td>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                {% if doc.project %}\n                    Project Name \u0627\u0644\u0645\u0634\u0631\u0648\u0639:\n                {% endif %}\n            </td>\n            <td style=\"width: 30%;\">\n                {% if doc.project %}\n                    {{ frappe.db.get_value(\"Project\", doc.project, \"project_name\") }}\n                {% endif %}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                {% if doc.set_warehouse %}\n                    Warehouse \u0627\u0644\u0645\u062e\u0632\u0646:\n                {% endif %}\n            </td>\n            <td style=\"width: 30%;\">\n                {% if doc.set_warehouse %}\n                    {{ doc.set_warehouse }}\n                {% endif %}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 12%;\">\n                \n            </td>\n            <td style=\"width: 33%;\">\n                {% if doc.driver_name %}\n                    <strong class=\"pf-color\">Delivered By \u0627\u0644\u0645\u0633\u062a\u0644\u0645:</strong>\n                {% endif %}\n            </td>\n            <td class=\"pf-color\" style=\"width: 30%;\">\n                {% if doc.driver_name %}\n                    {{ doc.driver_name }}\n                {% endif %}\n            </td>     \n        </tr>\n    </table>\n    \n    {% if doc.terms %}\n        <div class=\"pf-terms pf-font-size\">\n            <p><strong class=\"pf-color\">Terms and conditions</strong></p>\n            <br>\n            <p>{{ doc.terms }}</p>\n        </div>\n    {% endif %}\n    \n    {% if footer %}\n        <div id=\"footer-html\" class=\"visible-pdf\">\n            {{ footer }}\n        </div>\n    {% endif %}\n    \n</div>",
